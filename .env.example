ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (Llama) — used to extract Scales section values from CNSVS PDFs
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# llm (default) | hybrid (Groq + regex merge) | regex (no Groq)
SCALES_EXTRACTION_MODE=llm

# Serve CNSVS dashboard by default when opening "/"
APP_ENTRY=index.html

# Optional CNSVS backend URL used by /api/cnsvs/process.
# Legacy /api/pupilometry/parse is still supported as a compatibility alias.
# CNSVS_PROCESS_URL=http://127.0.0.1:8000/process-pdf-with-metadata
